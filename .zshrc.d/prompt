if [ -f /opt/homebrew/opt/zsh-git-prompt/zshrc.sh ]; then
    source /opt/homebrew/opt/zsh-git-prompt/zshrc.sh
    git_prompt() {
        if [ "$(git rev-parse --is-inside-work-tree 2> /dev/null)" = "true" ]; then
            PS1='%n@%m %1~ $(git_super_status) %# '
        else
            PS1='%n@%m %1~ %# '
        fi
    }
    precmd() {
        git_prompt
    }
else
    PS1='%n@%m %1~ %# '
fi
